# Copie para deploy.env e ajuste os valores no servidor.
# Exemplo: set -a && source deploy.env && set +a && uv run deploy

SECRET_KEY=altere-para-uma-chave-segura-e-aleatoria
DJANGO_DEBUG=false
ALLOWED_HOSTS=seu-dominio.org,www.seu-dominio.org

# Origens confiáveis para CSRF (com esquema). Normalmente os mesmos domínios
# de ALLOWED_HOSTS, prefixados com https://
CSRF_TRUSTED_ORIGINS=https://seu-dominio.org,https://www.seu-dominio.org

# Tempo do HSTS em segundos (padrão: 31536000 = 1 ano). Só tem efeito com
# DEBUG=false. Use um valor baixo (ex.: 300) ao testar HTTPS pela primeira vez.
SECURE_HSTS_SECONDS=31536000
